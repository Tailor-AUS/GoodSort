{
  "globalHeaders": {
    "Cache-Control": "no-cache, must-revalidate",
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(self), geolocation=(self), payment=(), usb=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.livelyfield-64227152.eastasia.azurecontainerapps.io https://api.tailor.au https://tiles.openfreemap.org https://photon.komoot.io https://router.project-osrm.org; img-src 'self' data: blob: https:; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'"
  },
  "routes": [
    {
      "route": "/_next/static/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/opengraph-image",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/twitter-image",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/brisbane/moorooka/opengraph-image",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/brisbane/annerley/opengraph-image",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/brisbane/tarragindi/opengraph-image",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/brisbane/moorooka/card",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/brisbane/annerley/card",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/brisbane/tarragindi/card",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=3600"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
